{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The spike predates the stricter options on the main project. It is scheduled for
    // deletion once nothing references it, so retrofitting them would be work on code
    // with an expiry date. See spike/README.md.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["spike"]
}
