{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simplyzombies.dev/schemas/affix.schema.json",
  "title": "Affix",
  "description": "A Path-of-Exile-shaped affix, per docs/10-items.md. Its effect is a modifier -- the same structure a web node, a weather state and an injury use, so one resolver serves all of them.",
  "type": "object",
  "required": ["id", "slot"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^affix\\.(prefix|suffix)\\.[a-z0-9_]+$",
      "description": "Stable namespaced id. Permanent once shipped."
    },
    "extends": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Display name, e.g. \"of the Quiet Hand\"."
    },
    "slot": { "enum": ["prefix", "suffix"] },
    "appliesTo": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Item base classes this affix can roll on."
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tier" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": ["weight", "modifiers"],
      "additionalProperties": false,
      "properties": {
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Relative roll weight. Rarer tiers weigh less."
        },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modifier" }
        }
      }
    },
    "modifier": {
      "type": "object",
      "required": ["stat", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "stat": {
          "type": "string",
          "description": "Must exist in the stat registry, or load fails."
        },
        "op": { "enum": ["set", "add", "mul", "min", "max"] },
        "value": { "type": "number" }
      }
    }
  }
}
