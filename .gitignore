node_modules/
dist/
.vite/
godot/.godot/
dist-godot/
.ci-tools/
# Godot 4 generated UIDs — regenerated on import, not source
*.uid
godot/**/*.uid
roadmap-*.html
.claude/worktrees/
# Python bytecode from tools/sprites/ — build.py sets sys.dont_write_bytecode, so this
# only catches an ad-hoc `python3 -c` import; a stale cache renders the previous palette.
__pycache__/
# The art review's capture driver writes here by default (godot:shots).
review-shots/

# Editor import leftovers next to the first-person art: the extracted atlas copies and their .import
# files. The GLBs and kit_atlas.png themselves are committed source and are not ignored.
godot/assets/first_person/*.import
godot/assets/first_person/*_kit_atlas.png

godot/assets/first_person/weapons/*.import
godot/assets/first_person/weapons/*_weapons_atlas.png
godot/assets/first_person/items/*.import
godot/assets/first_person/items/*_items_atlas.png
