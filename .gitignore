node_modules/
dist/
.vite/
godot/.godot/
dist-godot/
.ci-tools/
# Godot 4 generated UIDs — regenerated on import, not source
*.uid
godot/**/*.uid
roadmap-*.html
.claude/worktrees/
# Python bytecode from tools/sprites/ — build.py sets sys.dont_write_bytecode, so this
# only catches an ad-hoc `python3 -c` import; a stale cache renders the previous palette.
__pycache__/
# The art review's capture driver writes here by default (godot:shots).
review-shots/

# Editor import leftovers next to the first-person art: the extracted atlas copies and their .import
# files. The GLBs and kit_atlas.png themselves are committed source and are not ignored.
godot/assets/first_person/*.import
godot/assets/first_person/*_kit_atlas.png

godot/assets/first_person/weapons/*.import
godot/assets/first_person/weapons/*_weapons_atlas.png
godot/assets/first_person/items/*.import
godot/assets/first_person/items/*_items_atlas.png
godot/assets/first_person/props/*.import
godot/assets/first_person/props/*_props_atlas.png
# Godot-generated translation files beside the CSVs (docs/23).
godot/art/simplyzombies/docs/*.translation

# What a Godot import writes beside the sources: one sidecar per asset, and a copy of each GLB's atlas.
# No .import file is tracked. A fresh worktree's first import otherwise leaves twelve thousand untracked files.
godot/**/*.import
godot/assets/first_person/arms/*_arms_atlas.png
godot/assets/first_person/buildings/*_buildings_atlas.png
godot/assets/first_person/shambler_characters_atlas.png
godot/assets/first_person/survivor_survivor_atlas.png
# The look sheet's pictures, when --out points inside the repository.
look-shots/
