{
  "name": "simplyzombies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A hardcore survival colony sim about the cost of living well during the end of the world.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:frame": "node bench/frame.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "eslint": "^9.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.6"
  }
}
