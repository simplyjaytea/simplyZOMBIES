{
  "name": "simplyzombies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A hardcore survival colony sim about the cost of living well during the end of the world. Godot 4.7.1 is the playable build; TypeScript oracle archived at tag ts-oracle-final.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "handoff:regroup": "node scripts/regroup-handoff.mjs",
    "parity:r1:oracle": "node scripts/write-r1-oracle.mjs",
    "godot:test": "node scripts/run-godot.mjs --test",
    "godot:smoke": "node scripts/run-godot.mjs --smoke",
    "godot:export": "node scripts/run-godot.mjs --export",
    "godot:smoke:exports": "node scripts/smoke-godot-exports.mjs",
    "godot:editor": "node scripts/run-godot.mjs --editor",
    "godot:run": "node scripts/run-godot.mjs --run",
    "godot:validate": "node scripts/run-godot.mjs --validate",
    "godot:bench": "node scripts/run-godot.mjs --bench",
    "godot:r6:ticks": "node scripts/run-godot.mjs --r6-ticks",
    "godot:r6:coverage": "node scripts/run-godot.mjs --r6-coverage",
    "godot:r6:mutation": "node scripts/run-godot.mjs --r6-mutation",
    "godot:r6:soak": "node scripts/run-godot.mjs --r6-soak",
    "godot:r6": "npm run godot:r6:ticks && npm run godot:r6:coverage && npm run godot:r6:mutation && npm run godot:r6:soak && npm run godot:bench && npm run godot:validate",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:frame": "node bench/frame.mjs",
    "dev": "vite",
    "build": "npm run godot:export"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "eslint": "^9.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.6"
  }
}
