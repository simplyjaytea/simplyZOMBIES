{
  "name": "simplyzombies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A hardcore survival colony sim about the cost of living well during the end of the world. Godot 4.7.1 is the playable build; TypeScript oracle archived at tag ts-oracle-final.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:r1:oracle": "node scripts/write-r1-oracle.mjs",
    "godot:test": "node scripts/run-godot.mjs --test",
    "godot:smoke": "node scripts/run-godot.mjs --smoke",
    "godot:export": "node scripts/run-godot.mjs --export",
    "godot:smoke:exports": "node scripts/smoke-godot-exports.mjs",
    "godot:editor": "node scripts/run-godot.mjs --editor",
    "godot:run": "node scripts/run-godot.mjs --run",
    "godot:validate": "node scripts/run-godot.mjs --validate",
    "godot:bench": "node scripts/run-godot.mjs --bench",
    "godot:r6:ticks": "node scripts/run-godot.mjs --r6-ticks",
    "godot:r6:coverage": "node scripts/run-godot.mjs --r6-coverage",
    "godot:r6:mutation": "node scripts/run-godot.mjs --r6-mutation",
    "godot:r6:soak": "node scripts/run-godot.mjs --r6-soak",
    "godot:m2": "npm run godot:m2:lethality && npm run godot:m2:stats && npm run godot:m2:roster && npm run godot:m2:district && npm run godot:m2:ranged && npm run godot:m2:sight && npm run godot:m2:attach && npm run godot:m2:gear && npm run godot:m2:fortify && npm run godot:m2:director && npm run godot:m2:save && npm run godot:m2:needs && npm run godot:m2:jobs && npm run godot:m2:recruits && npm run godot:m2:aim && npm run godot:m2:web && npm run godot:m2:upkeep && npm run godot:m2:npc && npm run godot:m2:stance && npm run godot:m2:contact && npm run godot:m2:swipe && npm run godot:m2:wounds && npm run godot:m2:treatment && npm run godot:m2:recovery && npm run godot:m2:harness && npm run godot:m2:balance && npm run godot:ban:healthbar && npm run godot:check:appearance && npm run godot:check:loot && npm run godot:check:mods && npm run godot:check:hud && npm run godot:check:topdown",
    "godot:m2:lethality": "node scripts/run-godot.mjs --m2",
    "godot:m2:stats": "node scripts/run-godot.mjs --m2-stats",
    "godot:m2:roster": "node scripts/run-godot.mjs --m2-roster",
    "godot:m2:district": "node scripts/run-godot.mjs --m2-district",
    "godot:m2:ranged": "node scripts/run-godot.mjs --m2-ranged",
    "godot:m2:sight": "node scripts/run-godot.mjs --m2-sight",
    "godot:m2:attach": "node scripts/run-godot.mjs --m2-attach",
    "godot:m2:fortify": "node scripts/run-godot.mjs --m2-fortify",
    "godot:m2:director": "node scripts/run-godot.mjs --m2-director",
    "godot:m2:save": "node scripts/run-godot.mjs --m2-save",
    "godot:m2:needs": "node scripts/run-godot.mjs --m2-needs",
    "godot:m2:jobs": "node scripts/run-godot.mjs --m2-jobs",
    "godot:m2:recruits": "node scripts/run-godot.mjs --m2-recruits",
    "godot:m2:aim": "node scripts/run-godot.mjs --m2-aim",
    "godot:m2:web": "node scripts/run-godot.mjs --m2-web",
    "godot:m2:upkeep": "node scripts/run-godot.mjs --m2-upkeep",
    "godot:m2:npc": "node scripts/run-godot.mjs --m2-npc",
    "godot:m2:stance": "node scripts/run-godot.mjs --m2-stance",
    "godot:m2:contact": "node scripts/run-godot.mjs --m2-contact",
    "godot:m2:wounds": "node scripts/run-godot.mjs --m2-wounds",
    "godot:m2:treatment": "node scripts/run-godot.mjs --m2-treatment",
    "godot:m2:recovery": "node scripts/run-godot.mjs --m2-recovery",
    "godot:m2:balance": "node scripts/run-godot.mjs --m2-balance",
    "godot:m2:balance:full": "BALANCE_FULL=1 node scripts/run-godot.mjs --m2-balance",
    "godot:m2:harness": "node scripts/run-godot.mjs --m2-harness",
    "godot:m2:harness:full": "HARNESS_FULL=1 node scripts/run-godot.mjs --m2-harness",
    "godot:ban:healthbar": "node scripts/run-godot.mjs --ban-health-bar",
    "godot:check:appearance": "node scripts/run-godot.mjs --appearance",
    "godot:check:mods": "node scripts/run-godot.mjs --mods",
    "godot:check:loot": "node scripts/run-godot.mjs --loot",
    "godot:check:hud": "node scripts/run-godot.mjs --hud",
    "godot:check:topdown": "node scripts/run-godot.mjs --topdown",
    "godot:r6": "npm run godot:r6:ticks && npm run godot:r6:coverage && npm run godot:r6:mutation && npm run godot:r6:soak && npm run godot:m2 && npm run godot:bench && npm run godot:validate",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:frame": "node bench/frame.mjs",
    "dev": "vite",
    "build": "npm run godot:export",
    "godot:m2:gear": "node scripts/run-godot.mjs --m2-gear",
    "godot:m2:swipe": "node scripts/run-godot.mjs --m2-swipe"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "eslint": "^9.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.6"
  }
}
